# Keep real credentials in the ignored root .env file; never commit them.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public API URL consumed by the mobile app.
API_BASE_URL=http://localhost:4000/api

PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Cloudinary signed uploads for student and admin post media.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Apps Script Web App URL for sending emails
# Deploy Google Apps Script as Web App and paste the URL here
APPS_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# SMTP is required for sign-up and email OTP verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=UniOsunInfo <no-reply@example.com>